# Project name
PROJECT_NAME=llmsplay

# Set to true to use the GPU compose file and gpu PyTorch index; false for CPU
# The Makefile derives COMPOSE_FILE automatically from this value
USE_GPU=true

# Worker service name (used by make debug-worker and make jupyter)
WORKER_SERVICE=worker-service

# OpenAI API key for API calls and agent experiments
OPENAI_API_KEY=<INSERT SECRET KEY HERE>

# JupyterLab port (accessible at http://localhost:JUPYTER_EXTERNAL_PORT)
JUPYTER_EXTERNAL_PORT=8888

# MLflow tracking server port (accessible at http://localhost:MLFLOW_PORT)
MLFLOW_PORT=5000

# Official MLflow image used by mlflow-service (keep in sync with pyproject.toml)
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.17.0

# Paths inside the mlflow-service container; the project's mlflow/ directory
# is mounted at /mlflow, so both live under mlflow/ on the host
# Backend store: SQLite database with runs, params, metrics and traces
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/database.db

# Artifact store: models, plots and files from ML and generative AI experiments
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts

# Host headers accepted by the MLflow server (browser on the host + containers)
MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mlflow-service:*,mlflow-host:*,worker-service:*,worker-host:*

# Tracking URI used by the worker container (MLflow server on Docker's network)
MLFLOW_TRACKING_URI=http://mlflow-service:5000

# Ollama server port (accessible at http://localhost:OLLAMA_PORT from the host)
OLLAMA_PORT=11434

# Path (inside the container) to a Netscape-format cookies.txt exported from a
# logged-in YouTube session, used by yt-dlp to reduce bot-detection blocks
YT_DLP_COOKIES_FILE=<PATH TO COOKIES.TXT FILE>
